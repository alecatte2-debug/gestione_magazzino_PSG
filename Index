<style>
  @import url('https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;900&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap');

  .wh-root, .wh-login-wrap {
    --ink: #1C2321;
    --paper: #F6F5F0;
    --paper-2: #ECEAE2;
    --steel: #46536A;
    --amber: #E0932F;
    --amber-deep: #B96F1C;
    --green: #4C7A57;
    --rust: #B5533C;
    --line: #DAD5C8;
    font-family: 'Inter', sans-serif;
    color: var(--ink);
    background: var(--paper);
    min-height: 100vh;
  }
  html, body { margin: 0; padding: 0; }
  .wh-display { font-family: 'Barlow Condensed', sans-serif; font-weight: 800; letter-spacing: 0.01em; text-transform: uppercase; font-size: 28px; margin: 2px 0 0; }
  .wh-display-sm { font-family: 'Barlow Condensed', sans-serif; font-weight: 800; text-transform: uppercase; font-size: 20px; margin: 0; }
  .wh-eyebrow { font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--steel); margin: 0 0 2px; }
  .wh-mono { font-family: 'IBM Plex Mono', monospace; font-size: 13px; }
  .wh-dim { color: var(--steel); font-size: 13px; }
  .wh-strong { font-weight: 600; }

  * { box-sizing: border-box; }

  .wh-login-wrap { display: flex; align-items: center; justify-content: center; padding: 24px; }
  .wh-login-card { position: relative; width: 100%; max-width: 380px; background: #fff; border: 1px solid var(--line); border-radius: 4px; padding: 32px 28px 28px; box-shadow: 0 20px 50px -20px rgba(28,35,33,0.25); overflow: hidden; }
  .wh-badge-strip { position: absolute; top: 0; left: 0; right: 0; height: 8px; background: repeating-linear-gradient(90deg, var(--ink) 0 10px, var(--amber) 10px 20px); }
  .wh-login-head { display: flex; align-items: center; gap: 12px; margin-top: 12px; }
  .wh-login-icon { width: 42px; height: 42px; border-radius: 4px; background: var(--ink); color: var(--amber); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .wh-login-sub { color: var(--steel); font-size: 13.5px; line-height: 1.5; margin: 14px 0 22px; }
  .wh-login-form { display: flex; flex-direction: column; gap: 14px; }
  .wh-field { display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 600; }
  .wh-field span { font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--steel); font-weight: 500; }
  .wh-field input, .wh-field select { font-family: 'Inter', sans-serif; font-size: 14px; padding: 10px 12px; border: 1px solid var(--line); border-radius: 3px; background: var(--paper); color: var(--ink); outline: none; transition: border-color .15s, box-shadow .15s; }
  .wh-field input:focus, .wh-field select:focus { border-color: var(--amber-deep); box-shadow: 0 0 0 3px rgba(224,147,47,0.18); }
  .wh-login-error { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--rust); background: rgba(181,83,60,0.08); border: 1px solid rgba(181,83,60,0.25); padding: 8px 10px; border-radius: 3px; }
  .wh-login-submit { justify-content: center; margin-top: 4px; }

  .wh-btn { display: inline-flex; align-items: center; gap: 8px; font-family: 'Inter', sans-serif; font-weight: 600; font-size: 13.5px; padding: 9px 16px; border-radius: 3px; border: 1px solid transparent; cursor: pointer; transition: transform .1s, background .15s, border-color .15s; }
  .wh-btn:active { transform: translateY(1px); }
  .wh-btn:disabled { opacity: 0.6; cursor: default; }
  .wh-btn-primary { background: var(--ink); color: #fff; }
  .wh-btn-primary:hover { background: #2b332f; }
  .wh-btn-ghost { background: transparent; color: var(--ink); border-color: var(--line); }
  .wh-btn-ghost:hover { background: var(--paper-2); }
  .wh-btn-danger { background: var(--rust); color: #fff; }
  .wh-btn-danger:hover { background: #9a422f; }
  .wh-submit-move.stamp-in { border-left: 4px solid var(--green); }
  .wh-submit-move.stamp-out { border-left: 4px solid var(--rust); }
  .wh-submit-move.stamp-mid { border-left: 4px solid var(--steel); }
  .wh-spin { animation: wh-spin 0.9s linear infinite; }
  @keyframes wh-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .wh-spin { animation: none; } }

  .wh-topbar { display: flex; align-items: center; gap: 20px; padding: 14px 24px; background: var(--ink); color: #fff; flex-wrap: wrap; }
  .wh-topbar-left { display: flex; align-items: center; gap: 12px; margin-right: auto; }
  .wh-logo-mark { font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-size: 18px; background: var(--amber); color: var(--ink); width: 34px; height: 34px; border-radius: 3px; display: flex; align-items: center; justify-content: center; }
  .wh-topbar .wh-eyebrow { color: #C9C2AF; }
  .wh-user-line { font-size: 13.5px; font-weight: 600; margin: 0; }
  .wh-nav { display: flex; gap: 4px; flex-wrap: wrap; }
  .wh-nav-btn { display: flex; align-items: center; gap: 7px; background: transparent; border: 1px solid transparent; color: #D9D5C8; font-size: 13px; font-weight: 600; padding: 8px 12px; border-radius: 3px; cursor: pointer; transition: background .15s, color .15s; }
  .wh-nav-btn:hover { background: rgba(255,255,255,0.06); color: #fff; }
  .wh-nav-btn.active { background: var(--amber); color: var(--ink); }
  .wh-topbar .wh-btn-ghost { border-color: rgba(255,255,255,0.25); color: #fff; }
  .wh-topbar .wh-btn-ghost:hover { background: rgba(255,255,255,0.08); }

  .wh-main { padding: 28px 24px 60px; max-width: 1100px; margin: 0 auto; }
  .wh-view-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 22px; flex-wrap: wrap; }
  .wh-view-sub { color: var(--steel); font-size: 13.5px; margin: 8px 0 0; max-width: 520px; line-height: 1.5; }

  .wh-summary-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; margin-bottom: 22px; }
  .wh-summary-card { background: #fff; border: 1px solid var(--line); border-top: 3px solid var(--amber); border-radius: 3px; padding: 16px 18px; }
  .wh-summary-number { font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 30px; margin: 4px 0 2px; }
  .wh-summary-number span { font-size: 14px; font-weight: 500; color: var(--steel); text-transform: lowercase; font-family: 'Inter', sans-serif; }
  .wh-summary-sub { font-size: 12.5px; color: var(--steel); margin: 0; }

  .wh-searchbar { display: flex; align-items: center; gap: 8px; background: #fff; border: 1px solid var(--line); border-radius: 3px; padding: 9px 12px; margin-bottom: 16px; max-width: 380px; color: var(--steel); }
  .wh-searchbar input { border: none; outline: none; background: transparent; font-size: 13.5px; width: 100%; color: var(--ink); }
  .wh-filters { display: flex; gap: 10px; margin-bottom: 16px; flex-wrap: wrap; }
  .wh-filters select { padding: 8px 10px; border: 1px solid var(--line); border-radius: 3px; background: #fff; font-size: 13px; font-family: 'Inter', sans-serif; }

  .wh-table-wrap { background: #fff; border: 1px solid var(--line); border-radius: 3px; overflow-x: auto; }
  .wh-table { width: 100%; border-collapse: collapse; font-size: 13.5px; min-width: 560px; }
  .wh-table th { text-align: left; font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--steel); font-weight: 500; padding: 10px 14px; border-bottom: 1px solid var(--line); background: var(--paper-2); white-space: nowrap; }
  .wh-table td { padding: 10px 14px; border-bottom: 1px solid var(--line); vertical-align: middle; }
  .wh-table tr:last-child td { border-bottom: none; }
  .wh-num { text-align: right; }
  .wh-qty-low { color: var(--rust); font-weight: 700; }
  .wh-low-icon { color: var(--rust); margin-left: 4px; vertical-align: middle; }
  .wh-empty { text-align: center; color: var(--steel); padding: 28px; }
  .wh-row-actions { display: flex; gap: 6px; justify-content: flex-end; }
  .wh-icon-btn { width: 28px; height: 28px; display: flex; align-items: center; justify-content: center; background: transparent; border: 1px solid var(--line); border-radius: 3px; cursor: pointer; color: var(--ink); }
  .wh-icon-btn:hover { background: var(--paper-2); }
  .wh-icon-danger:hover { border-color: var(--rust); color: var(--rust); }

  .stamp { display: inline-block; font-family: 'Barlow Condensed', sans-serif; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; font-size: 12px; padding: 3px 9px; border: 2px dashed; border-radius: 3px; transform: rotate(-2deg); }
  .stamp-in { color: var(--green); border-color: var(--green); }
  .stamp-out { color: var(--rust); border-color: var(--rust); }
  .stamp-mid { color: var(--steel); border-color: var(--steel); }

  .wh-type-tabs { display: flex; gap: 8px; margin-bottom: 18px; flex-wrap: wrap; }
  .wh-type-tab { display: flex; align-items: center; gap: 7px; padding: 9px 16px; border-radius: 3px; border: 1px solid var(--line); background: #fff; font-weight: 600; font-size: 13.5px; cursor: pointer; color: var(--steel); }
  .wh-type-tab.active { background: var(--ink); color: #fff; border-color: var(--ink); }
  .wh-movement-card { background: #fff; border: 1px solid var(--line); border-radius: 3px; padding: 22px; max-width: 620px; }
  .wh-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 16px; }
  .wh-field-wide { grid-column: 1 / -1; }
  .wh-stock-hint { margin: 16px 0; font-size: 12.5px; color: var(--steel); background: var(--paper); border: 1px solid var(--line); border-radius: 3px; padding: 9px 12px; }
  .wh-modal-actions { grid-column: 1 / -1; display: flex; justify-content: flex-end; gap: 10px; margin-top: 6px; }

  .wh-modal-overlay { position: fixed; inset: 0; background: rgba(28,35,33,0.45); display: flex; align-items: center; justify-content: center; padding: 20px; z-index: 50; }
  .wh-modal { background: #fff; border-radius: 4px; padding: 24px; width: 100%; max-width: 460px; box-shadow: 0 30px 60px -20px rgba(0,0,0,0.4); }
  .wh-modal-sm { max-width: 400px; }
  .wh-modal-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
  .wh-modal-msg { font-size: 13.5px; color: var(--steel); line-height: 1.5; margin: 0 0 20px; }

  .wh-toast { position: fixed; bottom: 22px; left: 50%; transform: translateX(-50%); background: var(--ink); color: #fff; padding: 11px 18px; border-radius: 3px; display: flex; align-items: center; gap: 9px; font-size: 13.5px; font-weight: 500; box-shadow: 0 12px 30px -8px rgba(0,0,0,0.4); z-index: 60; border-left: 3px solid var(--green); }
  .wh-toast-error { border-left-color: var(--rust); }

  .wh-center-panel { display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 60px 20px; color: var(--steel); }

  @media (max-width: 640px) {
    .wh-form-grid { grid-template-columns: 1fr; }
    .wh-view-head { align-items: flex-start; }
    .wh-summary-number { font-size: 24px; }
  }
</style>
</head>
<body>
<div id="root"></div>

<script type="text/babel" data-presets="react,stage-3">
const { useState, useEffect, useCallback, useMemo } = React;

/* ------------------------------------------------------------------
   CONFIGURAZIONE SUPABASE
   La "anon key" è pensata per essere pubblica: va bene che sia qui.
   Non inserire MAI la "service_role" / chiave segreta in questo file.
------------------------------------------------------------------- */
const SUPABASE_URL = 'https://eggzhfalndxviflmenyq.supabase.co';
const SUPABASE_ANON_KEY = 'sb_publishable_fxKhT0eUF--5eoL9mDQ-1g_pwD5pkhI';
const supabase = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

const uid = () => Date.now().toString(36) + Math.random().toString(36).slice(2, 8);

function fmtDate(ts) {
  return new Date(ts).toLocaleString('it-IT', {
    day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit'
  });
}

const MOVE_TYPES = {
  carico: { label: 'Carico', cls: 'stamp-in', icon: 'packagePlus' },
  scarico: { label: 'Scarico', cls: 'stamp-out', icon: 'packageMinus' },
  trasferimento: { label: 'Trasferimento', cls: 'stamp-mid', icon: 'swap' },
};

/* ------------------------------ ICONE (SVG semplici, nessuna dipendenza) ------------------------------ */
const ICON_PATHS = {
  login: ["M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4", "M10 17l5-5-5-5", "M15 12H3"],
  logout: ["M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4", "M16 17l5-5-5-5", "M21 12H9"],
  box: ["M21 8l-9-5-9 5 9 5 9-5z", "M3 8v8l9 5 9-5V8", "M12 13v8"],
  boxes: ["M12 3l4 2-4 2-4-2 4-2z", "M8 7v4l4 2 4-2V7", "M4 9l4 2v4l-4-2z", "M20 9l-4 2v4l4-2z"],
  swap: ["M7 3 3 7l4 4", "M3 7h13", "M17 21l4-4-4-4", "M21 17H8"],
  packagePlus: ["M21 8l-9-5-9 5 9 5 9-5z", "M3 8v8l9 5 9-5V8", "M12 13v3", "M16.5 16.5h3", "M18 15v3"],
  packageMinus: ["M21 8l-9-5-9 5 9 5 9-5z", "M3 8v8l9 5 9-5V8", "M12 13v3", "M16.5 16.5h3"],
  history: ["M3 3v6h6", "M3 9a9 9 0 1 0 3-6.7", "M12 7v5l4 2"],
  search: ["M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14z", "M21 21l-4.35-4.35"],
  plus: ["M12 5v14", "M5 12h14"],
  pencil: ["M12 20h9", "M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"],
  trash: ["M3 6h18", "M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2", "M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"],
  warning: ["M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z", "M12 9v4", "M12 17h.01"],
  x: ["M18 6 6 18", "M6 6l12 12"],
  check: ["M20 6 9 17l-5-5"],
  loader: ["M12 2v4", "M12 18v4", "M4.93 4.93l2.83 2.83", "M16.24 16.24l2.83 2.83", "M2 12h4", "M18 12h4", "M4.93 19.07l2.83-2.83", "M16.24 7.76l2.83-2.83"],
  key: ["M21 2 19 4", "M7.5 15.5A5.5 5.5 0 1 0 12 6a5.5 5.5 0 0 0-4.5 9.5Z", "M11.5 11.5 4 19v3h3l7.5-7.5", "M15 15l4 4"],
  chevronRight: ["M9 18l6-6-6-6"],
  mail: ["M4 4h16v16H4Z", "M22 6 12 13 2 6"],
};

function Icon({ name, size = 16, className = '' }) {
  const paths = ICON_PATHS[name] || [];
  return (
    <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor"
      strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" className={className}>
      {paths.map((d, i) => <path key={i} d={d} />)}
    </svg>
  );
}

/* ------------------------------------------------------------------ */

function App() {
  const [authChecked, setAuthChecked] = useState(false);
  const [user, setUser] = useState(null);
  const [db, setDb] = useState(null);
  const [dbError, setDbError] = useState('');
  const [view, setView] = useState('dashboard');
  const [toast, setToast] = useState(null);

  const showToast = useCallback((msg, kind = 'ok') => {
    setToast({ msg, kind, id: uid() });
  }, []);

  useEffect(() => {
    if (!toast) return;
    const t = setTimeout(() => setToast(null), 3200);
    return () => clearTimeout(t);
  }, [toast]);

  useEffect(() => {
    supabase.auth.getSession().then(({ data }) => {
      if (data.session) setUser({ email: data.session.user.email });
      setAuthChecked(true);
    });
    const { data: listener } = supabase.auth.onAuthStateChange((_event, session) => {
      setUser(session ? { email: session.user.email } : null);
      if (!session) { setDb(null); setView('dashboard'); }
    });
    return () => listener.subscription.unsubscribe();
  }, []);

  const loadAll = useCallback(async () => {
    try {
      const [wh, prod, inv, mov] = await Promise.all([
        supabase.from('warehouses').select('*').order('id'),
        supabase.from('products').select('*').order('name'),
        supabase.from('inventory').select('*'),
        supabase.from('movements').select('*').order('ts', { ascending: false }).limit(500),
      ]);
      const firstError = wh.error || prod.error || inv.error || mov.error;
      if (firstError) throw firstError;

      const inventory = {};
      inv.data.forEach(r => {
        if (!inventory[r.product_id]) inventory[r.product_id] = {};
        inventory[r.product_id][r.warehouse_id] = Number(r.qty);
      });
      const products = prod.data.map(p => ({
        id: p.id, sku: p.sku, name: p.name, category: p.category,
        price: Number(p.price), minStock: Number(p.min_stock),
      }));
      const movements = mov.data.map(m => ({
        id: m.id, ts: new Date(m.ts).getTime(), type: m.type, user: m.user_email,
        productId: m.product_id, productName: m.product_name, productSku: m.product_sku,
        from: m.from_warehouse, to: m.to_warehouse, qty: Number(m.qty), note: m.note,
      }));
      setDb({ warehouses: wh.data, products, inventory, movements });
      setDbError('');
    } catch (e) {
      setDbError('Impossibile caricare i dati dal database. Controlla la connessione o le policy di Supabase.');
    }
  }, []);

  useEffect(() => { if (user) loadAll(); }, [user, loadAll]);

  const doCarico = useCallback(async (productId, warehouseId, qty, note) => {
    const product = db.products.find(p => p.id === productId);
    const current = (db.inventory[productId] || {})[warehouseId] || 0;
    const { error: e1 } = await supabase.from('inventory').upsert({ product_id: productId, warehouse_id: warehouseId, qty: current + qty });
    if (e1) return showToast('Errore nel salvataggio del carico.', 'error');
    const { error: e2 } = await supabase.from('movements').insert({
      id: uid(), type: 'carico', user_email: user.email, product_id: productId,
      product_name: product.name, product_sku: product.sku, from_warehouse: null, to_warehouse: warehouseId, qty, note,
    });
    if (e2) return showToast('Errore nel salvataggio del movimento.', 'error');
    await loadAll();
    showToast(`Carico registrato: +${qty} ${product.name}`);
  }, [db, user, loadAll, showToast]);

  const doScarico = useCallback(async (productId, warehouseId, qty, note) => {
    const product = db.products.find(p => p.id === productId);
    const current = (db.inventory[productId] || {})[warehouseId] || 0;
    if (qty > current) return showToast(`Giacenza insufficiente: disponibili solo ${current} unità`, 'error');
    const { error: e1 } = await supabase.from('inventory').upsert({ product_id: productId, warehouse_id: warehouseId, qty: current - qty });
    if (e1) return showToast('Errore nel salvataggio dello scarico.', 'error');
    const { error: e2 } = await supabase.from('movements').insert({
      id: uid(), type: 'scarico', user_email: user.email, product_id: productId,
      product_name: product.name, product_sku: product.sku, from_warehouse: warehouseId, to_warehouse: null, qty, note,
    });
    if (e2) return showToast('Errore nel salvataggio del movimento.', 'error');
    await loadAll();
    showToast(`Scarico registrato: -${qty} ${product.name}`);
  }, [db, user, loadAll, showToast]);

  const doTrasferimento = useCallback(async (productId, fromId, toId, qty, note) => {
    if (fromId === toId) return showToast('Seleziona due magazzini diversi', 'error');
    const product = db.products.find(p => p.id === productId);
    const current = (db.inventory[productId] || {})[fromId] || 0;
    if (qty > current) return showToast(`Giacenza insufficiente nel magazzino di origine (${current} disponibili)`, 'error');
    const currentTo = (db.inventory[productId] || {})[toId] || 0;
    const { error: e1 } = await supabase.from('inventory').upsert([
      { product_id: productId, warehouse_id: fromId, qty: current - qty },
      { product_id: productId, warehouse_id: toId, qty: currentTo + qty },
    ]);
    if (e1) return showToast('Errore nel salvataggio del trasferimento.', 'error');
    const { error: e2 } = await supabase.from('movements').insert({
      id: uid(), type: 'trasferimento', user_email: user.email, product_id: productId,
      product_name: product.name, product_sku: product.sku, from_warehouse: fromId, to_warehouse: toId, qty, note,
    });
    if (e2) return showToast('Errore nel salvataggio del movimento.', 'error');
    await loadAll();
    showToast(`Trasferite ${qty} unità di ${product.name}`);
  }, [db, user, loadAll, showToast]);

  const upsertProduct = useCallback(async (product) => {
    const isNew = !db.products.some(p => p.id === product.id);
    const { error } = await supabase.from('products').upsert({
      id: product.id, sku: product.sku, name: product.name,
      category: product.category, price: product.price, min_stock: product.minStock,
    });
    if (error) return showToast('Errore nel salvataggio del prodotto.', 'error');
    if (isNew) {
      await supabase.from('inventory').upsert([
        { product_id: product.id, warehouse_id: 'A', qty: 0 },
        { product_id: product.id, warehouse_id: 'B', qty: 0 },
      ]);
    }
    await loadAll();
    showToast(isNew ? 'Prodotto aggiunto' : 'Prodotto aggiornato');
  }, [db, loadAll, showToast]);

  const deleteProduct = useCallback(async (productId) => {
    const { error } = await supabase.from('products').delete().eq('id', productId);
    if (error) return showToast('Errore nell\'eliminazione del prodotto.', 'error');
    await loadAll();
    showToast('Prodotto eliminato');
  }, [loadAll, showToast]);

  const handleLogout = useCallback(async () => {
    await supabase.auth.signOut();
  }, []);

  if (!authChecked) {
    return (
      <div className="wh-root">
        <div className="wh-center-panel">
          <Icon name="loader" size={22} className="wh-spin" />
          <p>Verifica sessione…</p>
        </div>
      </div>
    );
  }

  if (!user) {
    return <LoginScreen />;
  }

  return (
    <div className="wh-root">
      <TopBar user={user} onLogout={handleLogout} view={view} setView={setView} />
      <main className="wh-main">
        {dbError ? (
          <div className="wh-center-panel"><Icon name="warning" size={22} /><p>{dbError}</p></div>
        ) : !db ? (
          <div className="wh-center-panel"><Icon name="loader" size={22} className="wh-spin" /><p>Caricamento dati magazzino…</p></div>
        ) : view === 'dashboard' ? (
          <DashboardView db={db} />
        ) : view === 'products' ? (
          <ProductsView db={db} onSave={upsertProduct} onDelete={deleteProduct} />
        ) : view === 'movement' ? (
          <MovementView db={db} onCarico={doCarico} onScarico={doScarico} onTrasferimento={doTrasferimento} />
        ) : (
          <HistoryView db={db} />
        )}
      </main>
      {toast && <Toast toast={toast} />}
    </div>
  );
}

/* ------------------------------ LOGIN ------------------------------ */

function LoginScreen() {
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [error, setError] = useState('');
  const [busy, setBusy] = useState(false);

  const submit = async () => {
    setError('');
    setBusy(true);
    const { error } = await supabase.auth.signInWithPassword({ email: email.trim(), password });
    setBusy(false);
    if (error) setError('Email o password non validi.');
  };

  return (
    <div className="wh-root wh-login-wrap">
      <div className="wh-login-card">
        <div className="wh-badge-strip" />
        <div className="wh-login-head">
          <div className="wh-login-icon"><Icon name="key" size={22} /></div>
          <div>
            <p className="wh-eyebrow">Accesso riservato</p>
            <h1 className="wh-display">Controllo Magazzini</h1>
          </div>
        </div>
        <p className="wh-login-sub">Accedi con l'email e la password create per te su Supabase.</p>

        <div className="wh-login-form">
          <label className="wh-field">
            <span>Email</span>
            <input
              autoFocus type="email" value={email}
              onChange={e => setEmail(e.target.value)}
              onKeyDown={e => { if (e.key === 'Enter') submit(); }}
              placeholder="mario@tuomagazzino.it"
              autoComplete="username"
            />
          </label>
          <label className="wh-field">
            <span>Password</span>
            <input
              type="password" value={password}
              onChange={e => setPassword(e.target.value)}
              onKeyDown={e => { if (e.key === 'Enter') submit(); }}
              placeholder="••••••••"
              autoComplete="current-password"
            />
          </label>

          {error && <div className="wh-login-error"><Icon name="warning" size={15} /> {error}</div>}

          <button type="button" onClick={submit} disabled={busy} className="wh-btn wh-btn-primary wh-login-submit">
            {busy ? <Icon name="loader" size={16} className="wh-spin" /> : <Icon name="login" size={16} />}
            {busy ? 'Verifica…' : 'Entra'}
          </button>
        </div>
      </div>
    </div>
  );
}

/* ------------------------------ NAV ------------------------------ */

function TopBar({ user, onLogout, view, setView }) {
  const items = [
    { id: 'dashboard', label: 'Giacenze', icon: 'boxes' },
    { id: 'movement', label: 'Nuovo movimento', icon: 'swap' },
    { id: 'history', label: 'Storico', icon: 'history' },
    { id: 'products', label: 'Prodotti', icon: 'box' },
  ];
  return (
    <header className="wh-topbar">
      <div className="wh-topbar-left">
        <span className="wh-logo-mark">M2</span>
        <div>
          <p className="wh-eyebrow">Gestione magazzini</p>
          <p className="wh-user-line">{user.email}</p>
        </div>
      </div>
      <nav className="wh-nav">
        {items.map(it => (
          <button key={it.id} className={`wh-nav-btn ${view === it.id ? 'active' : ''}`} onClick={() => setView(it.id)}>
            <Icon name={it.icon} size={16} /><span>{it.label}</span>
          </button>
        ))}
      </nav>
      <button className="wh-btn wh-btn-ghost" onClick={onLogout}><Icon name="logout" size={16} /> Esci</button>
    </header>
  );
}

/* ------------------------------ DASHBOARD ------------------------------ */

function DashboardView({ db }) {
  const [query, setQuery] = useState('');

  const rows = useMemo(() => {
    const q = query.trim().toLowerCase();
    return db.products
      .filter(p => !q || p.name.toLowerCase().includes(q) || p.sku.toLowerCase().includes(q) || (p.category || '').toLowerCase().includes(q))
      .map(p => {
        const inv = db.inventory[p.id] || {};
        const total = db.warehouses.reduce((s, w) => s + (inv[w.id] || 0), 0);
        return { product: p, inv, total };
      });
  }, [db, query]);

  const totals = useMemo(() => db.warehouses.map(w => ({
    warehouse: w,
    units: rows.reduce((s, r) => s + (r.inv[w.id] || 0), 0),
    value: rows.reduce((s, r) => s + (r.inv[w.id] || 0) * r.product.price, 0),
  })), [db, rows]);

  return (
    <div className="wh-view">
      <ViewHeader eyebrow="Panoramica" title="Giacenze per magazzino" subtitle="Quantità disponibili prodotto per prodotto, aggiornate ad ogni movimento." />

      <div className="wh-summary-row">
        {totals.map(t => (
          <div key={t.warehouse.id} className="wh-summary-card">
            <p className="wh-eyebrow">{t.warehouse.name}</p>
            <p className="wh-summary-number">{t.units.toLocaleString('it-IT')} <span>unità</span></p>
            <p className="wh-summary-sub">Valore stimato € {t.value.toLocaleString('it-IT', { maximumFractionDigits: 2 })}</p>
          </div>
        ))}
      </div>

      <div className="wh-searchbar">
        <Icon name="search" size={15} />
        <input placeholder="Cerca per nome, SKU o categoria…" value={query} onChange={e => setQuery(e.target.value)} />
      </div>

      <div className="wh-table-wrap">
        <table className="wh-table">
          <thead>
            <tr>
              <th>Prodotto</th><th>SKU</th><th>Categoria</th>
              {db.warehouses.map(w => <th key={w.id} className="wh-num">{w.name}</th>)}
              <th className="wh-num">Totale</th>
            </tr>
          </thead>
          <tbody>
            {rows.map(r => (
              <tr key={r.product.id}>
                <td className="wh-strong">{r.product.name}</td>
                <td className="wh-mono">{r.product.sku}</td>
                <td>{r.product.category}</td>
                {db.warehouses.map(w => {
                  const qty = r.inv[w.id] || 0;
                  const low = qty <= (r.product.minStock || 0);
                  return (
                    <td key={w.id} className="wh-num">
                      <span className={low ? 'wh-qty-low' : ''}>{qty}</span>
                      {low && <Icon name="warning" size={12} className="wh-low-icon" />}
                    </td>
                  );
                })}
                <td className="wh-num wh-strong">{r.total}</td>
              </tr>
            ))}
            {rows.length === 0 && <tr><td colSpan={4 + db.warehouses.length} className="wh-empty">Nessun prodotto trovato.</td></tr>}
          </tbody>
        </table>
      </div>
    </div>
  );
}

/* ------------------------------ PRODOTTI ------------------------------ */

function ProductsView({ db, onSave, onDelete }) {
  const [editing, setEditing] = useState(null);
  const [query, setQuery] = useState('');
  const [confirmDelete, setConfirmDelete] = useState(null);

  const filtered = db.products.filter(p => {
    const q = query.trim().toLowerCase();
    return !q || p.name.toLowerCase().includes(q) || p.sku.toLowerCase().includes(q);
  });

  return (
    <div className="wh-view">
      <ViewHeader eyebrow="Anagrafica" title="Prodotti" subtitle="Codice, categoria e prezzo di ogni articolo gestito nei due magazzini."
        action={<button className="wh-btn wh-btn-primary" onClick={() => setEditing('new')}><Icon name="plus" size={16} /> Nuovo prodotto</button>} />

      <div className="wh-searchbar">
        <Icon name="search" size={15} />
        <input placeholder="Cerca per nome o SKU…" value={query} onChange={e => setQuery(e.target.value)} />
      </div>

      <div className="wh-table-wrap">
        <table className="wh-table">
          <thead>
            <tr><th>SKU</th><th>Nome</th><th>Categoria</th><th className="wh-num">Prezzo</th><th className="wh-num">Scorta minima</th><th></th></tr>
          </thead>
          <tbody>
            {filtered.map(p => (
              <tr key={p.id}>
                <td className="wh-mono">{p.sku}</td>
                <td className="wh-strong">{p.name}</td>
                <td>{p.category}</td>
                <td className="wh-num">€ {Number(p.price).toLocaleString('it-IT', { minimumFractionDigits: 2 })}</td>
                <td className="wh-num">{p.minStock || 0}</td>
                <td className="wh-row-actions">
                  <button className="wh-icon-btn" onClick={() => setEditing(p)}><Icon name="pencil" size={14} /></button>
                  <button className="wh-icon-btn wh-icon-danger" onClick={() => setConfirmDelete(p)}><Icon name="trash" size={14} /></button>
                </td>
              </tr>
            ))}
            {filtered.length === 0 && <tr><td colSpan={6} className="wh-empty">Nessun prodotto trovato.</td></tr>}
          </tbody>
        </table>
      </div>

      {editing && (
        <ProductModal product={editing === 'new' ? null : editing} onClose={() => setEditing(null)}
          onSave={(p) => { onSave(p); setEditing(null); }} />
      )}
      {confirmDelete && (
        <ConfirmModal title="Eliminare il prodotto?"
          message={`"${confirmDelete.name}" verrà rimosso dall'anagrafica e dalle giacenze. Lo storico movimenti resterà invariato.`}
          onCancel={() => setConfirmDelete(null)}
          onConfirm={() => { onDelete(confirmDelete.id); setConfirmDelete(null); }} />
      )}
    </div>
  );
}

function ProductModal({ product, onClose, onSave }) {
  const [form, setForm] = useState(() => product ? { ...product } : { id: uid(), sku: '', name: '', category: '', price: '', minStock: '' });
  const [error, setError] = useState('');
  const set = (k, v) => setForm(f => ({ ...f, [k]: v }));

  const submit = () => {
    if (!form.sku.trim() || !form.name.trim()) { setError('SKU e nome sono obbligatori.'); return; }
    onSave({ ...form, price: Number(form.price) || 0, minStock: Number(form.minStock) || 0 });
  };

  return (
    <div className="wh-modal-overlay" onMouseDown={onClose}>
      <div className="wh-modal" onMouseDown={e => e.stopPropagation()}>
        <div className="wh-modal-head">
          <h2 className="wh-display-sm">{product ? 'Modifica prodotto' : 'Nuovo prodotto'}</h2>
          <button className="wh-icon-btn" onClick={onClose}><Icon name="x" size={16} /></button>
        </div>
        <div className="wh-form-grid">
          <label className="wh-field"><span>SKU / Codice</span><input value={form.sku} onChange={e => set('sku', e.target.value)} placeholder="es. VT-1001" /></label>
          <label className="wh-field"><span>Nome prodotto</span><input value={form.name} onChange={e => set('name', e.target.value)} placeholder="es. Vite autofilettante 4x30" /></label>
          <label className="wh-field"><span>Categoria</span><input value={form.category} onChange={e => set('category', e.target.value)} placeholder="es. Ferramenta" /></label>
          <label className="wh-field"><span>Prezzo unitario (€)</span><input type="number" step="0.01" min="0" value={form.price} onChange={e => set('price', e.target.value)} placeholder="0.00" /></label>
          <label className="wh-field"><span>Scorta minima (avviso)</span><input type="number" min="0" value={form.minStock} onChange={e => set('minStock', e.target.value)} placeholder="0" /></label>

          {error && <div className="wh-login-error"><Icon name="warning" size={15} /> {error}</div>}

          <div className="wh-modal-actions">
            <button type="button" className="wh-btn wh-btn-ghost" onClick={onClose}>Annulla</button>
            <button type="button" className="wh-btn wh-btn-primary" onClick={submit}><Icon name="check" size={16} /> Salva</button>
          </div>
        </div>
      </div>
    </div>
  );
}

function ConfirmModal({ title, message, onCancel, onConfirm }) {
  return (
    <div className="wh-modal-overlay" onMouseDown={onCancel}>
      <div className="wh-modal wh-modal-sm" onMouseDown={e => e.stopPropagation()}>
        <h2 className="wh-display-sm">{title}</h2>
        <p className="wh-modal-msg">{message}</p>
        <div className="wh-modal-actions">
          <button className="wh-btn wh-btn-ghost" onClick={onCancel}>Annulla</button>
          <button className="wh-btn wh-btn-danger" onClick={onConfirm}><Icon name="trash" size={15} /> Elimina</button>
        </div>
      </div>
    </div>
  );
}

/* ------------------------------ MOVIMENTO ------------------------------ */

function MovementView({ db, onCarico, onScarico, onTrasferimento }) {
  const [type, setType] = useState('carico');
  const [productId, setProductId] = useState(db.products[0]?.id || '');
  const [warehouseId, setWarehouseId] = useState(db.warehouses[0]?.id || '');
  const [fromId, setFromId] = useState(db.warehouses[0]?.id || '');
  const [toId, setToId] = useState(db.warehouses[1]?.id || db.warehouses[0]?.id || '');
  const [qty, setQty] = useState('');
  const [note, setNote] = useState('');
  const [busy, setBusy] = useState(false);

  const product = db.products.find(p => p.id === productId);
  const inv = product ? (db.inventory[product.id] || {}) : {};

  const submit = async () => {
    const q = Number(qty);
    if (!product || !q || q <= 0) return;
    setBusy(true);
    if (type === 'carico') await onCarico(productId, warehouseId, q, note);
    if (type === 'scarico') await onScarico(productId, warehouseId, q, note);
    if (type === 'trasferimento') await onTrasferimento(productId, fromId, toId, q, note);
    setBusy(false);
    setQty(''); setNote('');
  };

  const typeTabs = [
    { id: 'carico', label: 'Carico', icon: 'packagePlus' },
    { id: 'scarico', label: 'Scarico', icon: 'packageMinus' },
    { id: 'trasferimento', label: 'Trasferimento', icon: 'swap' },
  ];

  return (
    <div className="wh-view">
      <ViewHeader eyebrow="Operazione" title="Registra un movimento" subtitle="Carico e scarico aggiornano la giacenza di un magazzino; il trasferimento sposta merce tra i due." />

      <div className="wh-type-tabs">
        {typeTabs.map(t => (
          <button key={t.id} className={`wh-type-tab ${type === t.id ? 'active' : ''}`} onClick={() => setType(t.id)} type="button">
            <Icon name={t.icon} size={16} /> {t.label}
          </button>
        ))}
      </div>

      <div className="wh-movement-card">
        <div className="wh-form-grid">
          <label className="wh-field wh-field-wide">
            <span>Prodotto</span>
            <select value={productId} onChange={e => setProductId(e.target.value)}>
              {db.products.map(p => <option key={p.id} value={p.id}>{p.sku} — {p.name}</option>)}
            </select>
          </label>

          {type !== 'trasferimento' ? (
            <label className="wh-field">
              <span>Magazzino</span>
              <select value={warehouseId} onChange={e => setWarehouseId(e.target.value)}>
                {db.warehouses.map(w => <option key={w.id} value={w.id}>{w.name}</option>)}
              </select>
            </label>
          ) : (
            <>
              <label className="wh-field"><span>Da</span>
                <select value={fromId} onChange={e => setFromId(e.target.value)}>
                  {db.warehouses.map(w => <option key={w.id} value={w.id}>{w.name}</option>)}
                </select>
              </label>
              <label className="wh-field"><span>A</span>
                <select value={toId} onChange={e => setToId(e.target.value)}>
                  {db.warehouses.map(w => <option key={w.id} value={w.id}>{w.name}</option>)}
                </select>
              </label>
            </>
          )}

          <label className="wh-field"><span>Quantità</span>
            <input type="number" min="1" value={qty} onChange={e => setQty(e.target.value)} placeholder="0" />
          </label>
          <label className="wh-field wh-field-wide"><span>Nota (opzionale)</span>
            <input value={note} onChange={e => setNote(e.target.value)} placeholder="es. bolla n. 445, fornitore, ordine cliente…" />
          </label>
        </div>

        {product && (
          <div className="wh-stock-hint">
            <span>Giacenza attuale — </span>
            {db.warehouses.map((w, i) => (
              <span key={w.id} className="wh-mono">{w.name}: {inv[w.id] || 0}{i < db.warehouses.length - 1 ? '  ·  ' : ''}</span>
            ))}
          </div>
        )}

        <button type="button" onClick={submit} disabled={busy} className={`wh-btn wh-btn-primary wh-submit-move ${MOVE_TYPES[type].cls}`}>
          {busy ? <Icon name="loader" size={16} className="wh-spin" /> : <Icon name="chevronRight" size={16} />}
          Conferma {MOVE_TYPES[type].label.toLowerCase()}
        </button>
      </div>
    </div>
  );
}

/* ------------------------------ STORICO ------------------------------ */

function HistoryView({ db }) {
  const [filterType, setFilterType] = useState('tutti');
  const [filterWarehouse, setFilterWarehouse] = useState('tutti');

  const rows = db.movements.filter(m => {
    if (filterType !== 'tutti' && m.type !== filterType) return false;
    if (filterWarehouse !== 'tutti' && m.from !== filterWarehouse && m.to !== filterWarehouse) return false;
    return true;
  });

  const warehouseName = (id) => db.warehouses.find(w => w.id === id)?.name || '—';

  return (
    <div className="wh-view">
      <ViewHeader eyebrow="Registro" title="Storico movimenti" subtitle="Tutte le operazioni registrate, con utente e data." />

      <div className="wh-filters">
        <select value={filterType} onChange={e => setFilterType(e.target.value)}>
          <option value="tutti">Tutti i tipi</option>
          <option value="carico">Solo carichi</option>
          <option value="scarico">Solo scarichi</option>
          <option value="trasferimento">Solo trasferimenti</option>
        </select>
        <select value={filterWarehouse} onChange={e => setFilterWarehouse(e.target.value)}>
          <option value="tutti">Tutti i magazzini</option>
          {db.warehouses.map(w => <option key={w.id} value={w.id}>{w.name}</option>)}
        </select>
      </div>

      <div className="wh-table-wrap">
        <table className="wh-table wh-table-history">
          <thead>
            <tr><th>Tipo</th><th>Prodotto</th><th>Da → A</th><th className="wh-num">Quantità</th><th>Nota</th><th>Utente</th><th>Data</th></tr>
          </thead>
          <tbody>
            {rows.map(m => {
              const meta = MOVE_TYPES[m.type];
              return (
                <tr key={m.id}>
                  <td><span className={`stamp ${meta.cls}`}>{meta.label}</span></td>
                  <td><div className="wh-strong">{m.productName}</div><div className="wh-mono wh-dim">{m.productSku}</div></td>
                  <td>{m.from ? warehouseName(m.from) : '—'} → {m.to ? warehouseName(m.to) : '—'}</td>
                  <td className="wh-num wh-strong">{m.qty}</td>
                  <td className="wh-dim">{m.note || '—'}</td>
                  <td>{m.user}</td>
                  <td className="wh-dim">{fmtDate(m.ts)}</td>
                </tr>
              );
            })}
            {rows.length === 0 && <tr><td colSpan={7} className="wh-empty">Nessun movimento registrato.</td></tr>}
          </tbody>
        </table>
      </div>
    </div>
  );
}

/* ------------------------------ HELPERS UI ------------------------------ */

function ViewHeader({ eyebrow, title, subtitle, action }) {
  return (
    <div className="wh-view-head">
      <div>
        <p className="wh-eyebrow">{eyebrow}</p>
        <h1 className="wh-display">{title}</h1>
        {subtitle && <p className="wh-view-sub">{subtitle}</p>}
      </div>
      {action}
    </div>
  );
}

function Toast({ toast }) {
  return (
    <div className={`wh-toast ${toast.kind === 'error' ? 'wh-toast-error' : ''}`}>
      <Icon name={toast.kind === 'error' ? 'warning' : 'check'} size={15} />
      {toast.msg}
    </div>
  );
}

ReactDOM.createRoot(document.getElementById('root')).render(<App />);
</script>
</body>
</html>
